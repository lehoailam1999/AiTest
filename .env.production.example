# ===================================================
# AITEST PLATFORM - PRODUCTION ENVIRONMENT CONFIG TEMPLATE
# Sao chép tệp này thành .env.production trước khi chạy deploy.sh
# ===================================================

# 1. DATABASE CONFIG (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SET_ME>
POSTGRES_DB=AITestDb
POSTGRES_PORT=5433

# 2. BACKEND API SERVICE CONFIG
API_PORT=5000
JWT_KEY=<SET_ME_MIN_32_CHARS>
ENCRYPTION_KEY=<SET_ME_MIN_32_CHARS>
JWT_ISSUER=AITest.API
JWT_AUDIENCE=AITest.Client
JWT_ACCESS_HOURS=24
# Production: liệt kê origin thật (Desktop Tauri + Vite dev nếu cần). Tránh CORS_ORIGINS=* khi policy yêu cầu.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost

# 3. RULE RETRIEVAL CONFIG
AITEST_RULE_RETRIEVE_MODE=selective
AITEST_RULE_RETRIEVE_E2E=1
AITEST_RULE_RETRIEVE_ANALYSIS=1
AITEST_RULE_RETRIEVE_TCGEN=1
