{
  "name": "aitest",
  "version": "0.1.0",
  "private": true,
  "description": "AITest — Postgres + Python API + React/Tauri Desktop",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "setup:no-ext": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1 -SkipExtension",
    "db": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "cd api && .venv\\Scripts\\alembic.exe upgrade head && .venv\\Scripts\\alembic.exe revision --autogenerate -m migration",
    "db:up": "cd api && .venv\\Scripts\\alembic.exe upgrade head",
    "db:status": "cd api && .venv\\Scripts\\alembic.exe current",
    "db:rollback": "cd api && .venv\\Scripts\\alembic.exe downgrade -1",
    "api": "cd api && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "npm run api",
    "desktop": "npm run dev --prefix desktop",
    "desktop:build": "npm install --prefix packages/ide-protocol && npm install --prefix desktop && npm run build --prefix desktop",
    "desktop:ui": "npm run dev:ui --prefix desktop",
    "extension:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-ide-extension.ps1",
    "mock-ide": "npm run mock-ide --prefix packages/ide-protocol",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "dev": "npm run up",
    "test": "npm run test:protocol && npm run test:desktop",
    "test:protocol": "npm test --prefix packages/ide-protocol",
    "test:desktop": "npm run test:unit --prefix desktop",
    "test:api": "cd api && .venv\\Scripts\\python.exe -m pytest tests -q --tb=line"
  }
}